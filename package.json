{
  "name": "hashport-authentication-service",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm exec ts-node-dev --respawn --transpile-only src/index.ts",
    "start:dev": "pnpm exec ts-node src/index.ts",
    "build": "pnpm exec tsc -p tsconfig.json",
    "start": "NODE_ENV=production node dist/src/index.js",
    "deploy": "pnpm prisma:generate && pnpm prisma:migrate:deploy && pnpm prisma:seed && pnpm build && pnpm start",
    "prisma:generate": "pnpm exec prisma generate",
    "prisma:migrate:dev": "pnpm exec prisma migrate dev",
    "prisma:migrate:deploy": "pnpm exec prisma migrate deploy",
    "prisma:seed": "pnpm exec prisma db seed",
    "db:setup:dev": "pnpm prisma:generate && pnpm prisma:migrate:dev && pnpm prisma:seed",
    "db:setup:deploy": "pnpm prisma:generate && pnpm prisma:migrate:deploy && pnpm prisma:seed",
    "lint": "pnpm exec eslint src",
    "lint:fix": "pnpm exec eslint src --fix",
    "typecheck": "pnpm exec tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck"
  },

  "prisma": {
    "seed": "ts-node prisma/seed/index.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@google-cloud/kms": "^5.2.0",
    "@hashgraph/proto": "^2.25.0",
    "@hashgraph/sdk": "^2.78.0",
    "@prisma/client": "^6.15.0",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.4",
    "ethers": "^6.15.0",
    "express": "^5.1.0",
    "google-auth-library": "^10.5.0",
    "jose": "^6.1.0",
    "nodemailer": "^7.0.12"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^7.0.4",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.8.1",
    "prisma": "^6.15.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  }
}